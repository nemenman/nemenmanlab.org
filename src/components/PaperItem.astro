---
import type { CollectionEntry } from 'astro:content';
import { inlineMd } from '../lib/site';

interface Props { paper: CollectionEntry<'papers'>; compact?: boolean }
const { paper, compact = false } = Astro.props;
const p = paper.data;
const href = p.doi ? `https://doi.org/${p.doi}` : p.arxiv ? `https://arxiv.org/abs/${p.arxiv}` : undefined;
// Authors: lab members are _italic_ (as in the CV); bold the PI.
const authors = inlineMd(p.authors).replace(/\bI Nemenman\b/, '<strong class="font-semibold">I Nemenman</strong>');
---
<li class="py-6">
  <h3 class:list={['font-serif leading-snug', compact ? 'text-lg' : 'text-xl md:text-2xl']}>
    {href ? <a href={href} class="hover:text-navy">{p.title}</a> : p.title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-muted"><span set:html={authors} />. <em>{p.journal}</em> {p.citation}.</p>
  {!compact && <p class="mt-3 max-w-3xl font-serif text-lg italic leading-snug text-ink/80">{p.summary}</p>}
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
    {p.award && <span class="smallcaps text-gold">{p.award}</span>}
    {p.doi && <a class="link text-muted" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>}
    {p.arxiv && <a class="link text-muted" href={`https://arxiv.org/abs/${p.arxiv}`}>arXiv:{p.arxiv}</a>}
  </p>
</li>
