---
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
}
const { title, kicker, lede } = Astro.props;
---
<section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6 md:pt-16">
  {kicker && <p class="smallcaps mb-3 text-sm text-gold">{kicker}</p>}
  <h1 class="font-serif text-4xl leading-tight tracking-tight sm:text-5xl">{title}</h1>
  {lede && <p class="mt-5 max-w-3xl font-serif text-xl leading-relaxed text-ink/80">{lede}</p>}
  <slot />
</section>
