---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchCards from '../components/ResearchCards.astro';
import NewsList from '../components/NewsList.astro';
import { url, fmtDate } from '../lib/site';

const latest = (await getCollection('photos')).find((p) => p.data.latest)!;
const quote = (await getEntry('quotes', 'goldenfeld-kadanoff-bulldozers'))!;
---
<Base>
  <!-- Intro -->
  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-14 pt-12 sm:px-6 md:grid-cols-12 md:pt-20">
    <div class="md:col-span-8">
      <p class="smallcaps mb-4 text-sm text-gold">Theoretical biological physics · Emory University</p>
      <h1 class="font-serif text-4xl leading-[1.08] tracking-tight sm:text-5xl md:text-6xl">
        Information processing, adaptation, and learning: <em class="text-navy">learning biology</em> and <em class="text-navy">learning from biology</em>.
      </h1>
      <p class="mt-8 max-w-2xl font-serif text-xl leading-relaxed text-ink/80">
        We are a group happily existing on the interface between the physics and the biology departments at Emory University. We work to understand how biological systems, such as cells, organisms, and populations, learn from their surrounding environment and respond to it.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 text-sm font-medium">
        <a href={url('/research/')} class="rounded-sm bg-navy px-5 py-2.5 text-white hover:bg-navy/90">Our research</a>
        <a href={url('/join/')} class="rounded-sm border border-ink/20 px-5 py-2.5 hover:border-ink/50">Join the lab</a>
      </div>
    </div>
    <aside class="md:col-span-4 md:border-l md:border-rule md:pl-8">
      <p class="smallcaps text-xs text-muted">From <a href={url('/smart-thoughts/')} class="link">Smart Thoughts from Smart People</a></p>
      <blockquote class="mt-4 font-serif text-2xl italic leading-snug text-ink/90">“{quote.data.text}”</blockquote>
      <p class="mt-3 text-sm text-muted">{quote.data.author}, <em>Science</em> 284, 87–89 (1999)</p>
    </aside>
  </section>

  <!-- Research -->
  <section class="border-y border-rule bg-white/60">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-14">
      <div class="mb-6 flex items-baseline justify-between md:mb-10">
        <h2 class="font-serif text-3xl">Research</h2>
        <a href={url('/research/')} class="text-sm text-muted hover:text-ink">All research →</a>
      </div>
      <ResearchCards />
    </div>
  </section>

  <!-- Group photo + News -->
  <section class="mx-auto grid max-w-6xl gap-12 px-4 pt-16 sm:px-6 md:grid-cols-12">
    <figure class="md:col-span-7">
      <a href={url('/people/#group-photos')}>
        <Image src={latest.data.image} alt={`The Nemenman group, ${latest.data.date}`} widths={[480, 800, 1200]} sizes="(min-width: 1152px) 640px, (min-width: 768px) 58vw, 100vw" class="w-full" loading="eager" />
      </a>
      <figcaption class="mt-3 flex justify-between gap-4 border-b border-rule pb-3 text-sm text-muted">
        <span>The group, {fmtDate(latest.data.date)}.</span>
        <a href={url('/people/#group-photos')} class="whitespace-nowrap hover:text-ink">Group photos over the years →</a>
      </figcaption>
    </figure>
    <div class="md:col-span-5">
      <h2 class="font-serif text-3xl">News</h2>
      <div class="mt-6"><NewsList limit={4} /></div>
      <a href={url('/news/')} class="mt-4 inline-block text-sm text-muted hover:text-ink">All news →</a>
    </div>
  </section>
</Base>
