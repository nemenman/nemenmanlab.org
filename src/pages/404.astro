---
import Base from '../layouts/Base.astro';
import oldUrls from '../data/old-urls.json';
import { url } from '../lib/site';

// Map old wiki titles to absolute new paths for the client-side fallback below.
const map = Object.fromEntries(Object.entries(oldUrls as Record<string, string>).map(([k, v]) => [k, url(v)]));
---
<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="smallcaps text-sm text-gold">404</p>
    <h1 class="mt-3 font-serif text-4xl">This page isn’t here</h1>
    <p class="mt-4 font-serif text-xl text-ink/80" id="msg">The lab website moved to a new design in 2026. Most old pages have new homes.</p>
    <p class="mt-8 flex flex-wrap justify-center gap-6 text-sm">
      <a class="link" href={url('/')}>Home</a><a class="link" href={url('/people/')}>People</a><a class="link" href={url('/research/')}>Research</a><a class="link" href={url('/teaching/')}>Teaching</a><a class="link" href={url('/archive/')}>Old courses</a>
    </p>
  </section>
  <script is:inline define:vars={{ map, home: url('/') }}>
    // Old MediaWiki URLs: /~ilya/index.php/Title or /~ilya/index.php?title=Title
    (function () {
      var p = decodeURIComponent(location.pathname);
      var m = p.match(/~ilya\/index\.php\/(.+?)\/?$/);
      var t = m ? m[1] : new URLSearchParams(location.search).get('title');
      if (/~ilya/.test(p)) {
        var to = t && map[t.replace(/_/g, ' ')];
        location.replace(to || home);
      }
    })();
  </script>
</Base>
