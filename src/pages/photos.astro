---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url, fmtDate } from '../lib/site';

// Group photos by year, newest first. Thumbnails keep each photo's own shape (no cropping);
// clicking one opens it at full size, capped at 2000 px and never enlarged.
// Within a year: the current group photo (`latest`) first, then file-name order. Many photos
// carry only a year, so name them group-YYYY-N-… with N = 1 for the newest in that year.
const photos = (await getCollection('photos')).sort((a, b) =>
  b.data.date.slice(0, 4).localeCompare(a.data.date.slice(0, 4))
  || Number(!!b.data.latest) - Number(!!a.data.latest)
  || a.id.localeCompare(b.id));
const items = await Promise.all(photos.map(async (ph) => {
  const { image, title, caption, date } = ph.data;
  const full = await getImage({ src: image, width: Math.min(image.width, 2000), format: 'jpg' });
  // Older captions repeat the date and title ("May 2013. Group Picnic at Stone Mountain. Left to right: ...").
  const names = caption
    .replace(/^[A-Z][a-z]+ \d{4}[.,]\s*/, '')
    .replace(title ? new RegExp(`^${title}\\.\\s*`) : /^$/, '')
    .trim();
  // "2025", "2025-05", "2025-05-17" are formatted; anything else ("2023 or 2024") is shown as written.
  const when = /^\d{4}(-\d{2}){0,2}$/.test(date) ? fmtDate(date, 'long') : date;
  return { id: ph.id, image, title, names, when, year: date.slice(0, 4), full: full.src };
}));
const years = [...new Set(items.map((it) => it.year))];
---
<Base title="Group photos" description="Photos of the Nemenman group at Emory University, by year.">
  <PageHeader title="Group photos" kicker="The group over the years">
    <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Jump to year">
      {years.map((y) => <a href={`#y${y}`} class="link">{y}</a>)}
    </nav>
  </PageHeader>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {years.map((y) => (
      <section id={`y${y}`} class="scroll-mt-6 border-t border-rule pb-6 pt-8">
        <h2 class="font-serif text-3xl">{y}</h2>
        <div class="mt-6 gap-8 sm:columns-2 lg:columns-3">
          {items.filter((it) => it.year === y).map((it) => (
            <figure class="mb-10 break-inside-avoid" id={it.id}>
              <a href={it.full} class="block" aria-label={`Open full size: ${it.when}${it.title ? `, ${it.title}` : ''}`}>
                <Image
                  src={it.image}
                  alt={`The Nemenman group, ${it.when}${it.title ? `, ${it.title.toLowerCase()}` : ''}`}
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 350px, (min-width: 640px) 45vw, 100vw"
                  class="w-full"
                />
              </a>
              <figcaption class="mt-3 text-sm leading-relaxed text-muted">
                <span class="font-serif text-lg text-ink">{it.when}</span>
                {it.title && <span class="text-ink"> · {it.title}</span>}
                {it.names && <span class="block">{it.names}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
    <p class="border-t border-rule pt-6 text-sm text-muted"><a href={url('/people/')} class="link">← People</a></p>
  </div>
</Base>
