---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { inlineMd } from '../lib/site';

const quotes = (await getCollection('quotes')).sort((a, b) => a.data.order - b.data.order);
const topics: string[] = [];
for (const q of quotes) if (!topics.includes(q.data.topic)) topics.push(q.data.topic);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const yt = (id: string) => {
  const [v, qs] = id.split('?');
  return `https://www.youtube-nocookie.com/embed/${v}${qs ? '?' + qs : ''}`;
};
---
<Base title="Smart Thoughts from Smart People" description="Quotations on science, theory, models, and data, collected by Ilya Nemenman.">
  <PageHeader title="Smart Thoughts from Smart People" kicker="A collection" />
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav class="flex flex-wrap gap-x-5 gap-y-2 border-y border-rule py-3 text-sm text-muted" aria-label="Topics">
      {topics.map((t) => <a href={`#${slug(t)}`} class="hover:text-ink">{t}</a>)}
    </nav>
    {topics.map((t) => (
      <section id={slug(t)} class="grid gap-6 border-b border-rule py-12 md:grid-cols-12">
        <h2 class="smallcaps text-sm text-gold md:col-span-3">{t}</h2>
        <div class="space-y-12 md:col-span-9">
          {quotes.filter((q) => q.data.topic === t).map((q) => (
            <figure id={q.id}>
              {q.data.title && <p class="font-serif text-xl">{q.data.title}</p>}
              {q.data.text && (
                <blockquote class:list={['font-serif italic leading-snug text-ink/90', q.data.text.length > 400 ? 'text-lg' : 'text-2xl']}>
                  {q.data.text.split(/\n\s*\n/).map((para) => <p class="mt-3 first:mt-0">{para}</p>)}
                </blockquote>
              )}
              {q.data.youtube && (
                <div class="grid gap-4 sm:grid-cols-2">
                  {q.data.youtube.map((id) => (
                    <div class="aspect-video bg-black">
                      <iframe src={yt(id)} title={`${q.data.author}: video`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="h-full w-full"></iframe>
                    </div>
                  ))}
                </div>
              )}
              <figcaption class="mt-3 text-sm text-muted">
                <span class="font-medium text-ink">{q.data.author}</span>
                {q.data.source && <span class="block" set:html={inlineMd(q.data.source)} />}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
